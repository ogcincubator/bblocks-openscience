@prefix mom:  <https://rss-hydro.lu/ns/mom/> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix sh:   <http://www.w3.org/ns/shacl#> .
@base <https://rss-hydro.lu/ns/mom/rules/> .

<#hazardAccumulationUsedAggregate>
    a sh:NodeShape ;
    sh:targetClass mom:HazardScoreAccumulation ;
    sh:message "Hazard accumulation must use an aggregation output" ;
    sh:property [
        sh:path prov:used ;
        sh:qualifiedValueShape [
            sh:property [ sh:path prov:wasGeneratedBy ; sh:class mom:PerWatershedAggregation ; sh:minCount 1 ]
        ] ;
        sh:qualifiedMinCount 1 ;
    ] .

<#finalAlertUsedAccumulatedScore>
    a sh:NodeShape ;
    sh:targetClass mom:FinalAlert ;
    sh:message "Final alert must use a hazard score of a hazard score accumulation" ;
    sh:property [
        sh:path prov:used ;
        sh:qualifiedValueShape [
            sh:class mom:HazardScore ;
            sh:property [ sh:path prov:wasGeneratedBy ; sh:class mom:HazardScoreAccumulation ; sh:minCount 1 ]
        ] ;
        sh:qualifiedMinCount 1 ;
    ] .

<#hazardScoreDerivedFromDatedData>
    a sh:NodeShape ;
    sh:targetClass mom:HazardScore ;
    sh:sparql [
        sh:message "Hazard score must derive from model data with a mom:dataTime" ;
        sh:select """
            SELECT $this WHERE {
                FILTER NOT EXISTS {
                    $this <http://www.w3.org/ns/prov#wasDerivedFrom>+ ?data .
                    ?data <https://rss-hydro.lu/ns/mom/dataType> ?type ;
                          <https://rss-hydro.lu/ns/mom/dataTime> ?time .
                }
            }
        """ ;
    ] .
