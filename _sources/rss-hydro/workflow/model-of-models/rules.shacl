@prefix mom:  <https://rss-hydro.lu/ns/mom/> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix sh:   <http://www.w3.org/ns/shacl#> .
@base <https://rss-hydro.lu/ns/mom/rules/> .

# Process types and mom:HazardScore are given in activityType / entityType, which map to
# prov:type (not rdf:type). The shapes therefore select their focus nodes by prov:type value:
# each shape targets every node with a prov:type and only constrains those with the relevant
# type (the sh:or guard), and type tests use sh:hasValue on prov:type instead of sh:class.

<#hazardAccumulationUsedAggregate>
    a sh:NodeShape ;
    sh:targetSubjectsOf prov:type ;
    sh:message "Weighted scoring must use a zonal statistics output" ;
    sh:or (
        [ sh:not [ sh:property [ sh:path prov:type ;
                                 sh:hasValue <https://w3id.org/ogc/ospd/activity-type/WeightedScoringAndClassification> ] ] ]
        [ sh:property [
            sh:path prov:used ;
            sh:qualifiedValueShape [
                sh:property [ sh:path ( prov:wasGeneratedBy prov:type ) ;
                              sh:hasValue <https://w3id.org/ogc/ospd/activity-type/ZonalStatistics> ]
            ] ;
            sh:qualifiedMinCount 1 ;
        ] ]
    ) .

<#finalAlertUsedAccumulatedScore>
    a sh:NodeShape ;
    sh:targetSubjectsOf prov:type ;
    sh:message "Progress tracking must use a hazard score of a weighted scoring" ;
    sh:or (
        [ sh:not [ sh:property [ sh:path prov:type ;
                                 sh:hasValue <https://w3id.org/ogc/ospd/activity-type/ScoringAndProgressTracking> ] ] ]
        [ sh:property [
            sh:path prov:used ;
            sh:qualifiedValueShape [
                sh:property [ sh:path prov:type ; sh:hasValue mom:HazardScore ] ;
                sh:property [ sh:path ( prov:wasGeneratedBy prov:type ) ;
                              sh:hasValue <https://w3id.org/ogc/ospd/activity-type/WeightedScoringAndClassification> ]
            ] ;
            sh:qualifiedMinCount 1 ;
        ] ]
    ) .

<#hazardScoreDerivedFromDatedData>
    a sh:NodeShape ;
    sh:targetSubjectsOf prov:type ;
    sh:sparql [
        sh:message "Hazard score must derive from model data with a mom:dataTime" ;
        sh:select """
            SELECT $this WHERE {
                $this <http://www.w3.org/ns/prov#type> <https://rss-hydro.lu/ns/mom/HazardScore> .
                FILTER NOT EXISTS {
                    $this <http://www.w3.org/ns/prov#wasDerivedFrom>+ ?data .
                    ?data <https://rss-hydro.lu/ns/mom/dataType> ?type ;
                          <https://rss-hydro.lu/ns/mom/dataTime> ?time .
                }
            }
        """ ;
    ] .
