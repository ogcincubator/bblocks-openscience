@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix wg: <https://w3id.org/ogc/osc/prov-profiles/workflow-graph#> .

# Reusable descriptions - plans (including workflow definitions) and agents -
# should have an rdfs:label; a missing label is reported as a warning. This
# is checked on the uplifted graph, so a label may come from the JSON
# directly or be generated by an uplift rule (see uplift/labels.shacl, which
# derives rdfs:label from dcterms:title or skos:prefLabel). Other entities
# need not be labelled: they may be temporary artefacts passed between
# activities. Activities and the bundle that holds a
# run are records of a run and need not be labelled either.

wg:PlanHasLabel
  a sh:NodeShape ;
  sh:targetClass prov:Plan ;
  sh:property [
    sh:path rdfs:label ;
    sh:minCount 1 ;
    sh:severity sh:Warning ;
    sh:message "A plan (a reusable workflow or step description) should have an rdfs:label, given directly or generated during uplift." ;
  ] .

wg:AgentHasLabel
  a sh:NodeShape ;
  sh:targetClass prov:Agent, prov:Person, prov:Organization, prov:SoftwareAgent ;
  sh:property [
    sh:path rdfs:label ;
    sh:minCount 1 ;
    sh:severity sh:Warning ;
    sh:message "An agent should have an rdfs:label, given directly or generated during uplift." ;
  ] .
