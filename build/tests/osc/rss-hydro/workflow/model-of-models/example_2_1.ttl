    mom:dataTime "2026-02-28T00:00:00+00:00"^^xsd:dateTime ;
    mom:dataType "Source 2" .

run:watersheds a prov:Entity ;
    rdfs:label "Watershed_pfaf_id.shp" ;
    dcterms:format "ESRI Shapefile" ;
