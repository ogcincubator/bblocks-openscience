    prov:type prov:Organization .

run:resilience a prov:Entity ;
    rdfs:label "data/Resilience_Index.csv" ;
    dcterms:format "text/csv" ;
    dcterms:hasVersion "0.0.1-alpha" ;
    dcterms:isPartOf run:mom ;
