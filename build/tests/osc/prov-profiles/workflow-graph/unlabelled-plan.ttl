@prefix prov: <http://www.w3.org/ns/prov#> .

<urn:example:step:reproject> a prov:Activity ;
    prov:generated <urn:example:dataset:areas-utm32n> ;
    prov:qualifiedAssociation [ prov:agent <urn:example:agent:pipeline> ;
            prov:hadPlan <urn:example:plan:reproject> ] ;
    prov:type <https://register.ospd.dev.kurrawong.ai/catalogs/reg:top/collections/reg:52north/items/demo:GA018> ;
    prov:used <urn:example:dataset:areas-wgs84> .

<urn:example:plan:reproject> a prov:Entity,
        prov:Plan ;
    prov:type prov:Plan .

