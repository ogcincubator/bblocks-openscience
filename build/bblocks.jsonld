          "dct:conformsTo": "shacl:"
        },
        {
          "prof:hasArtifact": [
            "https://ogcincubator.github.io/bblocks-openscience/_sources/prov-profiles/processing-step/shapes.shacl"
          ],
          "rdfs:seeAlso": "bblocks://ogc.osc.prov-profiles.processing-step",
          "prof:hasRole": "role:validation",
          "dct:format": "text/turtle",
          "dct:conformsTo": "shacl:"
        }
      ],
      "ldContext": {
        "prof:hasArtifact": "https://ogcincubator.github.io/bblocks-openscience/build/annotated/osc/prov-profiles/workflow-graph/context.jsonld",
        "prof:hasRole": "role:mapping",
        "dct:format": "application/ld+json",
        "dct:conformsTo": "https://www.w3.org/TR/json-ld11/"
      },
      "schema": [
        {
          "prof:hasArtifact": "https://ogcincubator.github.io/bblocks-openscience/build/annotated/osc/prov-profiles/workflow-graph/schema.yaml",
          "prof:hasRole": "role:schema",
          "dct:format": "application/yaml",
          "dct:conformsTo": "https://json-schema.org/draft/2020-12/schema"
        },
        {
          "prof:hasArtifact": "https://ogcincubator.github.io/bblocks-openscience/build/annotated/osc/prov-profiles/workflow-graph/schema.json",
          "prof:hasRole": "role:schema",
          "dct:format": "application/json",
          "dct:conformsTo": "https://json-schema.org/draft/2020-12/schema"
        }
      ],
      "sourceSchema": "https://ogcincubator.github.io/bblocks-openscience/_sources/prov-profiles/workflow-graph/schema.yaml",
      "sourceLdContext": "https://ogcincubator.github.io/bblocks-openscience/_sources/prov-profiles/workflow-graph/context.jsonld",
      "resolvedSchemaProperties": "https://ogcincubator.github.io/bblocks-openscience/build/annotated/osc/prov-profiles/workflow-graph/resolvedProperties.json",
      "sourceFiles": "https://ogcincubator.github.io/bblocks-openscience/_sources/prov-profiles/workflow-graph/",
      "validationPassed": true,
      "testOutputs": "https://github.com/ogcincubator/bblocks-openscience/blob/master/build/tests/osc/prov-profiles/workflow-graph/",
      "semanticUplift": {
        "additionalSteps": [
          {
            "type": "shacl",
            "ref": "uplift/types.shacl",
            "inheritable": true,
            "stage": "post",
            "code": "@prefix sh: <http://www.w3.org/ns/shacl#> .\n@prefix prov: <http://www.w3.org/ns/prov#> .\n@prefix wg: <https://w3id.org/ogc/osc/prov-profiles/workflow-graph#> .\n\n# Type uplift rule (SHACL-AF), applied as a semantic-uplift step before validation.\n#\n# The PROV building blocks map entityType / activityType / agentType to prov:type, and only\n# provType to rdf:type. For an allow-list of classes, this rule also asserts the prov:type value\n# as rdf:type, so that shapes using sh:targetClass / sh:class (e.g. the label shapes for plans\n# and agents) apply:\n#   - the PROV subclasses: prov:Plan, prov:Bundle, prov:Collection, prov:EmptyCollection,\n#     prov:Person, prov:Organization, prov:SoftwareAgent;\n#   - the generic workflow classes of the activity-type register: acttype:WorkflowPlan,\n#     acttype:WorkflowRun, acttype:WorkflowRunner.\n#\n# Process types (registered activity types) are deliberately NOT copied: they stay prov:type\n# values. Asserting them as rdf:type would make every run an instance of a register item class\n# (acttype:ActivityType is a subclass of rim:RegisterItem), so register-item rules would apply\n# to runs. Shapes about process types should test prov:type values instead.\n\nwg:TypeFromProvType\n  a sh:NodeShape ;\n  sh:targetSubjectsOf prov:type ;\n  sh:rule [\n    a sh:SPARQLRule ;\n    sh:order 0 ;\n    sh:construct \"\"\"\n      CONSTRUCT { $this a ?type . }\n      WHERE {\n        $this <http://www.w3.org/ns/prov#type> ?type .\n        VALUES ?type {\n          <http://www.w3.org/ns/prov#Plan>\n          <http://www.w3.org/ns/prov#Bundle>\n          <http://www.w3.org/ns/prov#Collection>\n          <http://www.w3.org/ns/prov#EmptyCollection>\n          <http://www.w3.org/ns/prov#Person>\n          <http://www.w3.org/ns/prov#Organization>\n          <http://www.w3.org/ns/prov#SoftwareAgent>\n          <https://w3id.org/ogc/rim/activity-type/WorkflowPlan>\n          <https://w3id.org/ogc/rim/activity-type/WorkflowRun>\n          <https://w3id.org/ogc/rim/activity-type/WorkflowRunner>\n        }\n      }\n    \"\"\" ;\n  ] .\n"
          },
          {
            "type": "shacl",
            "ref": "uplift/labels.shacl",
            "inheritable": true,
            "stage": "post",
            "code": "@prefix sh: <http://www.w3.org/ns/shacl#> .\n@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .\n@prefix dcterms: <http://purl.org/dc/terms/> .\n@prefix skos: <http://www.w3.org/2004/02/skos/core#> .\n@prefix wg: <https://w3id.org/ogc/osc/prov-profiles/workflow-graph#> .\n\n# Label generation rules (SHACL-AF), applied as a semantic-uplift step.\n# Each rule adds an rdfs:label only to nodes that do not already have one.\n# Profiles may add their own rules (e.g. deriving a label from a file name)\n# in the same way.\n\nwg:NoLabel\n  a sh:NodeShape ;\n  sh:property [ sh:path rdfs:label ; sh:maxCount 0 ] .\n\nwg:LabelFromTitle\n  a sh:NodeShape ;\n  sh:targetSubjectsOf dcterms:title ;\n  sh:rule [\n    a sh:TripleRule ;\n    sh:order 1 ;\n    sh:condition wg:NoLabel ;\n    sh:subject sh:this ;\n    sh:predicate rdfs:label ;\n    sh:object [ sh:path dcterms:title ] ;\n  ] .\n\nwg:LabelFromPrefLabel\n  a sh:NodeShape ;\n  sh:targetSubjectsOf skos:prefLabel ;\n  sh:rule [\n    a sh:TripleRule ;\n    sh:order 2 ;\n    sh:condition wg:NoLabel ;\n    sh:subject sh:this ;\n    sh:predicate rdfs:label ;\n    sh:object [ sh:path skos:prefLabel ] ;\n  ] .\n"
          }
        ]
      },
