  "metaRegistry": "https://w3id.org/ogc/bblocks/meta-register.json",
  "name": "Building Blocks - Open Science Workflows Building Blocks",
  "abstract": "Building Blocks for FAIR Open Science - profiles of OGC API Processes and various metadata standards to support open, transparent, interoperable and reproducible scientific workflows..\n",
  "description": "This repository is initially aimed to support the [Open Science Persistent Demonstrator](https://www.ogc.org/initiatives/open-science/) pilot, but may be further developed as a set of standards with appropriate working group governance.\n",
  "sparqlEndpoint": "https://defs-dev.opengis.net/fuseki/query",
