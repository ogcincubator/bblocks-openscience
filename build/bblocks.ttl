<bblocks://ogc.osc.api-profiles.processes.ospd> a skos:Concept,
        dcat:Dataset,
        bblocks:Api,
        bblocks:BBlock ;
    rdfs:label "Open Science profile of OGC API Processes" ;
    dct:abstract "Support reproduceable science and interoperable workflows through profiling OGC API Processes to use a workflow model with transparent provenance and adherance to a common metadata profile for describing data inputs and outputs."^^<https://www.w3.org/ns/iana/media-types/text/markdown> ;
    dct:created "2023-09-18T00:00:00+00:00"^^xsd:dateTime ;
    dct:description [ dct:format "text/html" ;
            rdfs:isDefinedBy <https://ogcincubator.github.io/bblocks-openscience/bblock/ogc.osc.api-profiles.processes.ospd> ],
        [ dct:format "text/markdown" ;
            rdfs:isDefinedBy <https://ogcincubator.github.io/bblocks-openscience/build/generateddocs/markdown/osc/api-profiles/processes/ospd/index.md> ],
        [ dct:format "application/json" ;
            rdfs:isDefinedBy <https://ogcincubator.github.io/bblocks-openscience/build/generateddocs/json-full/osc/api-profiles/processes/ospd/index.json> ] ;
    dct:hasVersion "0.1" ;
    dct:modified "2026-11-26"^^xsd:date ;
    skos:inScheme <https://ogcincubator.github.io/bblocks-openscience/> ;
    skos:prefLabel "Open Science profile of OGC API Processes" ;
    skos:topConceptOf <https://ogcincubator.github.io/bblocks-openscience/> ;
    dcat:keyword "DCAT",
        "PROV",
        "Records",
        "STAC",
        "profile" ;
    prof:hasResource [ dct:conformsTo shacl: ;
            dct:format "text/turtle" ;
