<bblocks://ogc.osc.prov-profiles.hartis-provenance.cvi-workflow> a skos:Concept,
        dcat:Dataset,
        bblocks:BBlock,
        bblocks:Schema ;
    rdfs:label "HARTIS CVI Workflow Provenance" ;
    dct:abstract "A provenance profile for the complete HARTIS Coastal Vulnerability Index workflow, from configuration and source data through coastline extraction, transect generation, indicator calculations and the final CVI result."^^<https://www.w3.org/ns/iana/media-types/text/markdown> ;
    dct:created "2026-10-13T00:00:00+00:00"^^xsd:dateTime ;
    dct:description [ dct:format "text/html" ;
            rdfs:isDefinedBy <https://ogcincubator.github.io/bblocks-openscience/bblock/ogc.osc.prov-profiles.hartis-provenance.cvi-workflow> ],
        [ dct:format "application/json" ;
            rdfs:isDefinedBy <https://ogcincubator.github.io/bblocks-openscience/build/generateddocs/json-full/osc/prov-profiles/hartis-provenance/cvi-workflow/index.json> ],
        [ dct:format "text/markdown" ;
            rdfs:isDefinedBy <https://ogcincubator.github.io/bblocks-openscience/build/generateddocs/markdown/osc/prov-profiles/hartis-provenance/cvi-workflow/index.md> ],
        "This HARTIS D100 candidate profiles a complete workflow execution rather than a generic single processing step. It makes the workflow definition, planned processing activities, runtime activities, used entities and generated entities explicit so that the full CVI chain can be reviewed and reproduced."^^<https://www.w3.org/ns/iana/media-types/text/markdown> ;
    dct:hasVersion "0.1.0" ;
    dct:modified "2026-11-26"^^xsd:date ;
    dct:source <https://github.com/hartis-org/cvi-workflow>,
        <https://github.com/hartis-org/cvi-workflow/blob/ospd2026-d100/ospd2026/report/d001-hartis-contribution.md> ;
    skos:inScheme <https://ogcincubator.github.io/bblocks-openscience/> ;
    skos:prefLabel "HARTIS CVI Workflow Provenance" ;
    skos:topConceptOf <https://ogcincubator.github.io/bblocks-openscience/> ;
    prof:hasResource [ dct:conformsTo <https://www.w3.org/TR/json-ld11/> ;
            dct:format "application/ld+json" ;
            prof:hasArtifact <https://ogcincubator.github.io/bblocks-openscience/build/annotated/osc/prov-profiles/hartis-provenance/cvi-workflow/context.jsonld> ;
            prof:hasRole role:mapping ],
        [ dct:conformsTo <https://json-schema.org/draft/2020-12/schema> ;
            dct:format "application/json" ;
            prof:hasArtifact <https://ogcincubator.github.io/bblocks-openscience/build/annotated/osc/prov-profiles/hartis-provenance/cvi-workflow/schema.json> ;
            prof:hasRole role:schema ],
        [ dct:conformsTo shacl: ;
